# CẤU HÌNH BIẾN MÔI TRƯỜNG DÀNH CHO RENDER (ENVIRONMENT VARIABLES)
# Khai báo các biến này trên Dashboard của Render.com (KHÔNG commit chuỗi có mật khẩu thật vào Git)

# 1. Chuỗi kết nối MongoDB Atlas (Lấy từ MongoDB Atlas Dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@clustergamephcn2d.xxxxx.mongodb.net/?retryWrites=true&w=majority

# 2. Tên Database
MONGO_DB=rehab_pixel_game

# 3. Khóa bảo mật API
API_KEY=rehab_pixel_game

# 4. Cổng chạy của Render (Render tự động cấp qua $PORT)
PORT=10000
