[node name="Instructions" type="Label" parent="UI/InstructionPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "1. Cánh tay dang hai bên, cẳng tay gập 90° hướng lên.\n2. Hai bàn tay đưa ra sau đầu.\n3. Chạy trên bậc đá ~5 giây để tới vùng nhảy an toàn.\n4. Khép khuỷu về giữa và giữ đúng tư thế 5 giây để nhảy lên bậc kế.\n5. Hoàn thành 2 hiệp × 5 bậc; nghỉ 30 giây giữa hiệp."
autowrap_mode = 2

[node name="SafetyNote" type="Label" parent="UI/InstructionPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.18, 0.10, 1)
theme_override_font_sizes/font_size = 15
text = "Vùng nhảy luôn dừng an toàn trên bậc đá. Mất tracking sẽ tự động tạm dừng."
horizontal_alignment = 1

