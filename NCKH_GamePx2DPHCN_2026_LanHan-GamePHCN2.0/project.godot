; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="New Game Project"
run/main_scene="res://ui/screens/start/start_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Global="*res://core/autoload/global.gd"
PoseInput="*res://core/pose/backend_pose_provider.gd"
AudioManager="*res://core/audio/audio_manager.gd"
HandCursor="*res://ui/shared/hand_cursor_layer.tscn"

[display]

window/size/mode=2
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/shared/ui/game_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
